---
layout: null
permalink: /site.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": "Haven Arch",
  "icons": [
    {
      "src": {{ '/assets/favicons/android-chrome-192x192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": {{ '/assets/favicons/android-chrome-512x512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "#f5f7f8",
  "background_color": "#f5f7f8",
  "display": "standalone"
}
